if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
    target_include_directories(vamana_search SYSTEM PRIVATE vendor/diskann/arm64-compat)
    target_compile_options(vamana_search PRIVATE -include "${PROJECT_SOURCE_DIR}/vendor/diskann/arm64-compat/immintrin.h")
    if(ANDROID)
        target_include_directories(vamana_search SYSTEM PRIVATE "${ANN_SIMDE_ROOT}")
    endif()
endif()
foreach(pair IN ITEMS "ann_build;vamana_build" "ann_query_official;vamana_query_official")
    list(GET pair 0 original)
    list(GET pair 1 alias)
    add_custom_command(TARGET ${original} POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different "$<TARGET_FILE:${original}>" "${CMAKE_BINARY_DIR}/bin/${alias}")
endforeach()
