# The NDK toolchain must be passed to this project's top-level CMake entry.
if(NOT ANDROID_ABI STREQUAL "arm64-v8a")
    message(FATAL_ERROR "This Android profile requires arm64-v8a")
endif()
add_library(ann_platform INTERFACE)
target_compile_definitions(ann_platform INTERFACE _LIBCPP_ENABLE_CXX17_REMOVED_UNARY_BINARY_FUNCTION)

set(ROOT "${PROJECT_SOURCE_DIR}")
set(DISKANN "${ROOT}/vendor/diskann")
set(GENERATED "${CMAKE_BINARY_DIR}/generated")
set(ANN_BOOST_INCLUDE_DIR "${PROJECT_SOURCE_DIR}/.deps/android" CACHE PATH "Directory containing Boost 1.71 headers")
set(BOOST_HEADERS "${ANN_BOOST_INCLUDE_DIR}")
set(ANN_SIMDE_ROOT "${PROJECT_SOURCE_DIR}/.deps/android/simde-0.8.2" CACHE PATH "SIMDe headers")
set(SIMDE_ROOT "${ANN_SIMDE_ROOT}")
set(ANN_BOOST_PROGRAM_OPTIONS_SOURCE "${PROJECT_SOURCE_DIR}/.deps/android/program_options-boost-1.71.0" CACHE PATH "Boost program_options source")
set(BOOST_PO "${ANN_BOOST_PROGRAM_OPTIONS_SOURCE}")
find_package(Python3 REQUIRED COMPONENTS Interpreter)
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/cmake/prepare_diskann_android.py" "${DISKANN}" "${GENERATED}" RESULT_VARIABLE prepared)
if(NOT prepared EQUAL 0)
  message(FATAL_ERROR "Could not prepare memory-only source copies")
endif()
if(NOT EXISTS "${BOOST_HEADERS}/boost/version.hpp" OR NOT EXISTS "${SIMDE_ROOT}/simde/x86/avx2.h")
  message(FATAL_ERROR "Missing documented header dependencies")
endif()
file(GLOB BOOST_PO_SOURCES CONFIGURE_DEPENDS "${BOOST_PO}/src/*.cpp")
add_library(boost_program_options_android STATIC ${BOOST_PO_SOURCES})
target_include_directories(boost_program_options_android SYSTEM PUBLIC "${BOOST_HEADERS}")
target_compile_definitions(boost_program_options_android PUBLIC BOOST_ALL_NO_LIB _LIBCPP_ENABLE_CXX17_REMOVED_UNARY_BINARY_FUNCTION)
set(memory_sources abstract_data_store ann_exception index in_mem_graph_store
    in_mem_data_store natural_number_map natural_number_set scratch logger utils
    filter_utils abstract_index memory_mapper)
set(memory_files)
foreach(name IN LISTS memory_sources)
  list(APPEND memory_files "${DISKANN}/src/${name}.cpp")
endforeach()
add_library(diskann_memory STATIC ${memory_files} "${GENERATED}/distance_portable.cpp" "${GENERATED}/index_factory_memory.cpp" "${GENERATED}/pq_table_lifetime.cpp")
target_include_directories(diskann_memory PUBLIC "${GENERATED}/include")
target_include_directories(diskann_memory SYSTEM PUBLIC "${BOOST_HEADERS}")
target_compile_options(diskann_memory PRIVATE -O3 -fno-builtin-malloc -fno-builtin-calloc -fno-builtin-realloc -fno-builtin-free)
target_compile_definitions(diskann_memory PRIVATE USE_AVX2)
  target_include_directories(diskann_memory PUBLIC "${DISKANN}/arm64-compat")
  target_include_directories(diskann_memory SYSTEM PUBLIC "${SIMDE_ROOT}")
  target_compile_options(diskann_memory PUBLIC -include "${DISKANN}/arm64-compat/immintrin.h" -fopenmp)
  target_link_options(diskann_memory PUBLIC -fopenmp -static-openmp)
target_link_libraries(diskann_memory PUBLIC ann_platform m)
add_executable(ann_build "${DISKANN}/apps/build_memory_index.cpp")
add_executable(ann_query_official "${DISKANN}/apps/search_memory_index.cpp")
foreach(app ann_build ann_query_official)
  target_link_libraries(${app} PRIVATE diskann_memory boost_program_options_android)
  target_compile_options(${app} PRIVATE -O3)
endforeach()
add_executable(fvecs_to_bin "${DISKANN}/apps/utils/fvecs_to_bin.cpp")
target_link_libraries(fvecs_to_bin PRIVATE diskann_memory)
